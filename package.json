{
  "name": "@flowy-agent-store/site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/copy-market-tree.mjs",
    "sync": "node scripts/sync-market-tree.mjs && node scripts/sync-market-data.mjs",
    "sync:tree": "node scripts/sync-market-tree.mjs",
    "sync:market": "node scripts/sync-market-data.mjs",
    "import:experts": "node scripts/import-expert-bundles.mjs",
    "preview": "react-router preview",
    "typecheck": "tsc --noEmit",
    "check:docs-sync": "node scripts/check-docs-sync.mjs",
    "test:docs-sync": "bun test scripts/check-docs-sync.test.mjs",
    "check:market": "node scripts/check-market.mjs",
    "test:market": "bun test scripts/check-market.test.mjs",
    "test:market-zips": "bun test scripts/pack-market-zips.test.mjs",
    "pack:market": "node scripts/pack-market-zips.mjs",
    "publish:market": "node scripts/publish-market-zips.mjs",
    "check:release": "bun run check:docs-sync && bun run test:docs-sync && bun run check:market && bun run test:market && bun run test:market-zips && bun run typecheck",
    "release:pack": "node scripts/release.mjs pack",
    "release:publish": "node scripts/release.mjs publish",
    "release:status": "node scripts/release.mjs status"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "i18next": "^26.4.2",
    "isbot": "^5.2.2",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.1",
    "@react-router/node": "^8.3.1",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
