# React Router generated types/cache
.react-router/

# Build output (React Router SSG → static files)
build/

# Dependencies
node_modules/

# Market tree is committed on purpose: the site itself serves it as the
# marketplace source. It lives outside `public/` (Vite would copy it during the
# build and stall prerender) and is copied into the output by
# scripts/copy-market-tree.mjs — see scripts/sync-market-tree.mjs.

# Release artifacts (zips are built per release by scripts/release.mjs and
# uploaded to GitHub Releases; never commit them)
dist-release/

# Logs
*.log
*.err

# OS / editor
.DS_Store
Thumbs.db


# The IDE's own project folder. Anchored on purpose: an unanchored
# `.codebuddy/` also matches directories of that name *inside* the mirrored
# market trees (`…/skills/<skill>/.codebuddy/`). That silently kept real
# payload files out of the commit while `_files.txt` still advertised them —
# 84 phantom entries in the experts market, see scripts/sync-market-tree.mjs.
/.codebuddy/

# Tencent Cloud EdgeOne
.env
.edgeone/*
.tef_dist/*
  