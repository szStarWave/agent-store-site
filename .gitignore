# React Router generated types/cache
.react-router/

# Build output (React Router SSG → static files)
build/

# Dependencies
node_modules/

# Market tree is committed on purpose: the site itself serves it as the
# marketplace source. It lives outside `public/` (Vite would copy it during the
# build and stall prerender) and is copied into the output by
# scripts/copy-market-tree.mjs — see scripts/sync-market-tree.mjs.

# Release artifacts (zips are built per release by scripts/release.mjs and
# uploaded to GitHub Releases; never commit them)
dist-release/

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
